{
  "name": "rugpull-bakery-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-session": "tsx scripts/create-session-config.ts",
    "prepare-register-tx": "tsx -r dotenv/config scripts/prepare-register-tx.ts",
    "status": "tsx scripts/status.ts"
  },
  "dependencies": {
    "@abstract-foundation/agw-client": "^1.8.0",
    "dotenv": "^17.4.2",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
